@model ProgressViewModel
@{
    ViewData["Title"] = "Tiến độ học tập";
    var overallWidth = $"{Math.Clamp(Model.OverallProgress, 0, 100):0}%";
}
<section class="page">
    <header class="page-heading"><div><h1>Tiến độ học tập</h1><p>Dữ liệu được tính từ bài học và bài kiểm tra của tài khoản hiện tại.</p></div></header>

    <div class="grid grid-3" style="margin-bottom:16px">
        <article class="card stat-card"><span>Bài học hoàn thành</span><strong>@Model.CompletedLessonCount / @Model.TotalLessonCount</strong></article>
        <article class="card stat-card"><span>Bài kiểm tra đã làm</span><strong>@Model.CompletedTestCount / @Model.TotalTestCount</strong></article>
        <article class="card stat-card"><span>Tiến độ tổng thể</span><strong>@Model.OverallProgress.ToString("0")%</strong><div class="progress-track"><span style="width:@overallWidth"></span></div></article>
    </div>

    <section class="card" style="margin-bottom:16px">
        <h2 style="margin-top:0">Tiến độ theo chủ đề</h2>
        <div class="grid grid-2">
            @foreach (var topic in Model.TopicProgresses)
            {
                var topicWidth = $"{Math.Clamp(topic.ProgressPercent, 0, 100):0}%";
                <div><div class="page-heading" style="margin-bottom:7px"><span>@topic.TopicName</span><strong>@topic.ProgressPercent.ToString("0")%</strong></div><div class="progress-track"><span style="width:@topicWidth"></span></div></div>
            }
        </div>
    </section>

    <section class="card" style="margin-bottom:16px">
        <h2 style="margin-top:0">Bài học đã hoàn thành</h2>
        <div class="table-wrap"><table><thead><tr><th>#</th><th>Bài học</th><th>Chủ đề</th><th>Ngày hoàn thành</th><th></th></tr></thead><tbody>
            @if (Model.CompletedLessons.Count == 0)
            {
                <tr><td colspan="5" class="muted">Chưa có bài học hoàn thành.</td></tr>
            }
            else
            {
                @for (var i = 0; i < Model.CompletedLessons.Count; i++)
                {
                    var lesson = Model.CompletedLessons[i];
                    <tr><td>@(i + 1)</td><td>@lesson.LessonTitle</td><td>@lesson.TopicName</td><td>@lesson.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy")</td><td><a asp-controller="Lesson" asp-action="Index" asp-route-id="@lesson.LessonId" class="button secondary small">Xem lại</a></td></tr>
                }
            }
        </tbody></table></div>
    </section>

    <section class="card">
        <h2 style="margin-top:0">Lịch sử làm bài kiểm tra</h2>
        <div class="table-wrap"><table><thead><tr><th>#</th><th>Bài kiểm tra</th><th>Format</th><th>Ngày làm</th><th>Điểm</th><th>Kết quả</th></tr></thead><tbody>
            @if (Model.TestHistory.Count == 0)
            {
                <tr><td colspan="6" class="muted">Chưa có kết quả bài kiểm tra.</td></tr>
            }
            else
            {
                @for (var i = 0; i < Model.TestHistory.Count; i++)
                {
                    var item = Model.TestHistory[i];
                    <tr><td>@(i + 1)</td><td><a asp-controller="Test" asp-action="Result" asp-route-id="@item.ResultId">@item.TestTitle</a></td><td>@(item.Format == TestFormat.ToeicStyle ? "TOEIC-style" : "IELTS-style")</td><td>@item.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.Score.ToString("0.##")/100</td><td><span class="badge @(item.Score >= 70 ? "success" : "danger")">@(item.Score >= 70 ? "Đạt" : "Cần cải thiện")</span></td></tr>
                }
            }
        </tbody></table></div>
    </section>
</section>
