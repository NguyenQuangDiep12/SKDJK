@model MyLessonPageViewModel
@{
    // Tiêu đề được layout dùng để tạo title của trình duyệt.
    ViewData["Title"] = "Bài học của tôi";
}

<section class="page my-lessons-page">
    <header class="page-heading">
        <div>
            <h1>Bài học của tôi</h1>
            <p>Mở lại bài học gần nhất của bạn.</p>
        </div>
    </header>

    @* Chưa có LearningProgress nghĩa là người dùng chưa từng truy cập bài học nào. *@
    @if (!Model.HasLesson)
    {
        <section class="card my-lessons-empty" aria-live="polite">
            <span class="my-lessons-empty-icon" aria-hidden="true">▣</span>
            <h2>Chưa có bài học nào</h2>
            <p>Bạn chưa học chủ đề nào. Hãy chọn một chủ đề để bắt đầu.</p>
            <a asp-controller="Topic" asp-action="Index" class="button">Xem danh sách chủ đề</a>
        </section>
    }
    else
    {
        // LatestLesson chắc chắn có dữ liệu vì nhánh này chỉ chạy khi HasLesson bằng true.
        var lesson = Model.LatestLesson!;

        // Bài hoàn thành luôn hiển thị đủ 100%; bài đang dở dùng tiến độ thật trong database.
        var progress = lesson.IsCompleted ? 100 : Math.Clamp(lesson.CompletionPercent, 0, 100);

        // Chuỗi phần trăm được dùng cho chiều rộng thanh tiến độ.
        var progressWidth = $"{progress:0}%";

        <section class="card my-lessons-section">
            <div class="my-lessons-heading">
                <h2>Bài học gần nhất</h2>
                <span class="badge @(lesson.IsCompleted ? "success" : "")">
                    @(lesson.IsCompleted ? "Đã hoàn thành" : "Đang học")
                </span>
            </div>

            <article class="my-lesson-row">
                <div class="my-lesson-icon" aria-hidden="true">@(lesson.IsCompleted ? "✓" : "▣")</div>
                <div class="my-lesson-content">
                    <div class="my-lesson-title-row">
                        <h3>@lesson.LessonTitle</h3>
                    </div>
                    <p>@lesson.TopicName · @lesson.LanguageName</p>
                    @if (!string.IsNullOrWhiteSpace(lesson.Description))
                    {
                        <p class="my-lesson-description">@lesson.Description</p>
                    }
                    <div class="my-lesson-progress-line">
                        <div class="progress-track"><span style="width:@progressWidth"></span></div>
                        <strong>@progress.ToString("0")%</strong>
                    </div>
                    <small>
                        @(lesson.IsCompleted ? "Hoàn thành gần nhất" : "Lần học gần nhất"):
                        @(lesson.LastStudyAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác định")
                    </small>
                </div>
                <a asp-controller="Lesson"
                   asp-action="Index"
                   asp-route-id="@lesson.LessonId"
                   class="button @(lesson.IsCompleted ? "secondary" : "")">
                    @(lesson.IsCompleted ? "Xem lại" : "Tiếp tục học")
                </a>
            </article>
        </section>
    }
</section>
