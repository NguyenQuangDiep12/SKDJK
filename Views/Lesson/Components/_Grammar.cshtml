@model GrammarLearningViewModel
<section>
    <div class="page-heading"><div><h2 style="margin:0">Ngữ pháp</h2><p>Lý thuyết của bài @Model.LessonTitle</p></div></div>
    <article class="card">
        <div class="badge">Lý thuyết · cấu trúc · ví dụ</div>
        @if (string.IsNullOrWhiteSpace(Model.Content))
        {
            <p class="muted">Bài học chưa có nội dung ngữ pháp.</p>
        }
        else
        {
            <p style="white-space:pre-line;line-height:1.8;font-size:16px">@Model.Content</p>
        }
    </article>
</section>
