@model VocabularyLearningViewModel
<section>
    <div class="page-heading"><div><h2 style="margin:0">Luyện nói</h2><p>Nghe audio mẫu của từng từ rồi tự luyện phát âm theo.</p></div></div>
    @if (Model.Items.Count == 0)
    {
        <div class="card muted">Bài học chưa có từ để luyện phát âm.</div>
    }
    else
    {
        <div class="grid grid-2">
            @foreach (var item in Model.Items)
            {
                <article class="card">
                    <div class="page-heading" style="margin:0">
                        <div><h3 style="margin:0">@item.Word</h3><p class="muted pronunciation-text">@item.Pronunciation · @item.Meaning</p></div>
                        <button type="button" class="button pronounce-button" data-word="@item.Word">🔊 Nghe mẫu</button>
                    </div>
                    <p>@item.Example</p>
                    <p class="audio-status"></p>
                </article>
            }
        </div>
    }
</section>
