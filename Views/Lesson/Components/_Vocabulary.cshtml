@model VocabularyLearningViewModel
<section>
    <div class="page-heading"><div><h2 style="margin:0">Từ vựng</h2><p>Thẻ nhớ và ví dụ trong bài @Model.LessonTitle</p></div><span class="badge">@Model.LessonTotal từ</span></div>
    @if (Model.Items.Count == 0)
    {
        <div class="card muted">Bài học chưa có từ vựng.</div>
    }
    else
    {
        <div class="grid grid-2">
            <article class="card vocab-word">
                <span class="badge">Thẻ nhớ</span>
                <h2 id="vocabulary-word"></h2>
                <p id="vocabulary-pronunciation" class="muted"></p>
                <strong id="vocabulary-meaning"></strong>
                <button type="button" id="play-word-audio" class="button" style="margin-top:14px">🔊 Nghe phát âm từ Free Dictionary</button>
                <p id="vocabulary-audio-status" class="audio-status"></p>
            </article>
            <article class="card">
                <h3 style="margin-top:0">Ví dụ</h3>
                <p id="vocabulary-example" style="font-size:18px;line-height:1.6"></p>
                <p class="muted">Audio chỉ phát từ mục từ của Free Dictionary; hệ thống không dùng browser TTS.</p>
            </article>
        </div>
        <div class="vocab-actions">
            <button type="button" id="previous-vocabulary" class="button secondary">← Từ trước</button>
            <strong id="vocabulary-position"></strong>
            <button type="button" id="next-vocabulary" class="button">Từ tiếp →</button>
        </div>
        <script type="application/json" id="vocabulary-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(x => new { vocabularyId = x.VocabularyId, word = x.Word, meaning = x.Meaning, pronunciation = x.Pronunciation, example = x.Example, audioUrl = x.AudioUrl })))</script>
    }
</section>
