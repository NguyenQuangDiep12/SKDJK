@model SKDJK.ViewModels.VocabularyLearningViewModel

<section class="lesson-module" id="vocabulary-module">

    <div class="lesson-module-heading">
        <div>
            <h1>Từ vựng</h1>
            <p>Chủ đề: @Model.LessonTitle</p>
        </div>

        <span class="lesson-counter">
            Bài @Model.LessonId / @Model.LessonTotal
        </span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="lesson-ui-card">
            Chưa có dữ liệu từ vựng.
        </div>
    }
    else
    {
        <div class="lesson-two-column vocabulary-layout">

            <div class="lesson-column vocabulary-left-column">

                <!-- THẺ NHỚ -->
                <article class="lesson-ui-card vocabulary-word-card">

                    <div class="lesson-section-title">
                        <span class="section-number">1</span>
                        <strong>Thẻ nhớ</strong>
                    </div>

                    <div class="word-main">

                        <h2 id="vocabulary-word"></h2>

                        <div class="pronunciation-row">

                            <span id="vocabulary-pronunciation"></span>

                            <button type="button"
                                    id="play-word-audio"
                                    class="small-audio-button">
                                🔊
                            </button>

                        </div>

                        <div class="word-divider"></div>

                        <strong id="vocabulary-meaning"
                                class="word-meaning">
                        </strong>

                    </div>

                    <div class="example-box">

                        <span>
                            Ví dụ:
                            <span id="vocabulary-example"></span>
                        </span>

                        <button type="button"
                                id="play-example-audio"
                                class="small-audio-button">
                            🔊
                        </button>

                    </div>

                </article>


                <!-- ĐOÁN NGHĨA -->
                <article class="lesson-ui-card vocabulary-guess-card">

                    <div class="lesson-section-title">
                        <span class="section-number">2</span>
                        <strong>Đoán nghĩa</strong>
                    </div>

                    <p class="lesson-question">
                        Nghĩa của
                        “<strong id="guess-word"></strong>”
                        là gì?
                    </p>

                    <div class="answer-grid"
                         id="meaning-answer-grid">
                    </div>

                    <button type="button"
                            id="check-meaning-answer"
                            class="ui-primary-button full-width">
                        Kiểm tra đáp án
                    </button>

                    <p id="meaning-result"></p>

                </article>

            </div>


            <div class="lesson-column vocabulary-right-column">

                <!-- NGHE -->
                <article class="lesson-ui-card listening-card">

                    <div class="lesson-section-title">
                        <span class="section-number">3</span>
                        <strong>Nghe từ vựng</strong>
                    </div>

                    <p class="lesson-hint">
                        Nghe và chọn từ bạn nghe được
                    </p>

                    <div class="audio-player">

                        <button type="button"
                                id="play-listening-audio"
                                class="audio-play-button">
                            ▶
                        </button>

                        <div class="audio-content">

                            <div class="audio-time">
                                <span>0:00</span>
                                <span id="audio-duration">0:00</span>
                            </div>

                            <div class="audio-track">
                                <div class="audio-track-fill"
                                     id="audio-track-fill">
                                </div>
                            </div>

                        </div>

                        <button type="button"
                                id="sound-button"
                                class="audio-sound-button">
                            🔊
                        </button>

                    </div>

                    <div class="answer-grid listening-answer-grid"
                         id="listening-answer-grid">
                    </div>

                    <div class="lesson-action-row">

                        <button type="button"
                                id="listen-again"
                                class="ui-secondary-button">
                            Nghe lại
                        </button>

                        <button type="button"
                                id="check-listening-answer"
                                class="ui-primary-button">
                            Nộp câu trả lời
                        </button>

                    </div>

                    <p id="listening-result"></p>

                </article>

            </div>

        </div>

        <div class="vocabulary-navigation">

            <button type="button"
                    id="previous-vocabulary"
                    class="ui-secondary-button">
                ← Trước
            </button>

            <span id="vocabulary-position"></span>

            <button type="button"
                    id="next-vocabulary"
                    class="ui-primary-button">
                Tiếp →
            </button>

        </div>
    }

    <audio id="vocabulary-audio"></audio>

    <!-- Đổ Model.Items thành JSON cho Javascript -->
    <script type="application/json" id="vocabulary-data">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Items.Select(x => new
            {
                    vocabularyId = x.VocabularyId,
                    word = x.Word,
                    meaning = x.Meaning,
                    pronunciation = x.Pronunciation,
                    example = x.Example,
                    audioUrl = x.AudioUrl
            })
                ))
    </script>

</section>