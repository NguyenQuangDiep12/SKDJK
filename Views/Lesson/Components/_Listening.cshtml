<section class="lesson-module">
    <div class="lesson-module-heading">
        <div>
            <h1>Luyện nghe</h1>
            <p>Nghe đoạn hội thoại và chọn câu trả lời đúng</p>
        </div>

        <span class="lesson-counter">Bài 5 / 10</span>
    </div>

    <div class="lesson-two-column listening-layout">

        <div class="lesson-column">

            <article class="lesson-ui-card">
                <div class="lesson-section-title">
                    <span class="section-number">1</span>
                    <strong>Đoạn hội thoại</strong>
                </div>

                <div class="audio-hero">
                    <div class="audio-hero-icon">🎧</div>
                    <strong>Travel conversation</strong>
                    <span>01:24</span>
                </div>

                <div class="audio-player">
                    <button type="button" class="audio-play-button">▶</button>

                    <div class="audio-track">
                        <div class="audio-track-fill listening-progress"></div>
                    </div>

                    <span>1:24</span>

                    <button type="button" class="audio-sound-button">🔊</button>
                </div>

                <div class="lesson-action-row">
                    <button type="button" class="ui-secondary-button">
                        Nghe chậm
                    </button>

                    <button type="button" class="ui-secondary-button">
                        Nghe lại
                    </button>
                </div>
            </article>

            <article class="lesson-ui-card transcript-card">
                <div class="lesson-section-title">
                    <span class="section-number">2</span>
                    <strong>Gợi ý</strong>
                </div>

                <p>
                    Tập trung vào địa điểm, thời gian và phương tiện được nhắc đến
                    trong đoạn hội thoại.
                </p>
            </article>

        </div>

        <div class="lesson-column">

            <article class="lesson-ui-card">
                <div class="lesson-section-title">
                    <span class="section-number">3</span>
                    <strong>Câu hỏi nghe hiểu</strong>
                </div>

                <p class="lesson-question">
                    Where is the speaker going?
                </p>

                <div class="answer-list">
                    <button type="button">A. The airport</button>
                    <button type="button">B. The hotel</button>
                    <button type="button">C. The beach</button>
                    <button type="button">D. The station</button>
                </div>

                <button type="button" class="ui-primary-button full-width">
                    Nộp câu trả lời
                </button>
            </article>

            <article class="lesson-ui-card">
                <div class="lesson-section-title">
                    <span class="section-number">4</span>
                    <strong>Điền từ còn thiếu</strong>
                </div>

                <p class="lesson-question">
                    “I would like to book a ____ for two nights.”
                </p>

                <input class="lesson-input"
                       type="text"
                       placeholder="Nhập từ bạn nghe được..." />
            </article>

        </div>
    </div>
</section>
