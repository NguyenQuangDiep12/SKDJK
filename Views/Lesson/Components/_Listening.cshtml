@model ListeningLearningViewModel
<section>
    <div class="page-heading"><div><h2 style="margin:0">Luyện nghe</h2><p>Dùng audio từ câu Listening đã cấu hình cho bài học.</p></div></div>
    @if (Model.Questions.Count == 0)
    {
        <div class="card muted">Bài học chưa có nội dung luyện nghe.</div>
    }
    else
    {
        <div class="grid grid-2">
            @foreach (var question in Model.Questions)
            {
                <article class="card">
                    <span class="badge">Listening · Part/Section @question.PartNumber</span>
                    @if (!string.IsNullOrWhiteSpace(question.ImageUrl))
                    {
                        <img src="@question.ImageUrl" alt="Hình câu luyện nghe" class="topic-image" style="margin-top:12px" />
                    }
                    @if (!string.IsNullOrWhiteSpace(question.AudioUrl))
                    {
                        <audio controls preload="none" src="@question.AudioUrl" style="width:100%;margin:12px 0"></audio>
                    }
                    <strong>@question.Content</strong>
                    @if (question.Answers.Count > 0)
                    {
                        <div class="answer-options">
                            @foreach (var answer in question.Answers)
                            {
                                <label class="answer-option"><input type="radio" name="practice-@question.QuestionId" /><span>@answer.Content</span></label>
                            }
                        </div>
                    }
                    else
                    {
                        <input type="text" placeholder="Nhập từ bạn nghe được..." style="width:100%;margin-top:12px;padding:10px;border:1px solid var(--line);border-radius:8px" />
                    }
                </article>
            }
        </div>
        <p class="muted" style="margin-top:12px">Đây là phần luyện tập. Chấm điểm chính thức được thực hiện ở trang bài kiểm tra và luôn ở server.</p>
    }
</section>
