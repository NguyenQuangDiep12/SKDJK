@* Header bám wireframe: thương hiệu, tìm kiếm và tài khoản. *@
<header class="header">
    <a asp-controller="Home" asp-action="Index" class="header-brand">
        <span class="brand-logo">SK</span>
        <span>Hệ thống học ngoại ngữ trực tuyến</span>
    </a>
    @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("ADMIN"))
    {
        <form asp-controller="Topic" asp-action="Index" method="get" class="header-search">
            <input name="search" type="search" placeholder="Tìm kiếm chủ đề..." aria-label="Tìm kiếm chủ đề" />
            <button type="submit" style="border:0;background:transparent">⌕</button>
        </form>
    }
    <div class="header-user">
        <span style="font-weight:700">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Khách")</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="button secondary small">Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login" class="button small">Đăng nhập</a>
        }
    </div>
</header>
