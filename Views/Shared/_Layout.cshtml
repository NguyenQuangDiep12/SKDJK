@{
    var hideNavigation = ViewData["HideNavigation"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống học ngoại ngữ trực tuyến</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>

    @if (!hideNavigation)
    {
        <partial name="_Header" />

        <div class="app-layout">
            <partial name="_Sidebar" />

            <main class="main-content page-animate">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="auth-page page-animate">
            @RenderBody()
        </main>
    }

    <partial name="_Footer" />

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
