@using System.Security.Claims

<div class="user-info">

    @if (User.Identity?.IsAuthenticated == true)
    {
        // ============================
        // ĐÃ ĐĂNG NHẬP
        // ============================

        <button type="button"
                id="userMenuButton"
                class="user-button user-button-authenticated"
                aria-expanded="false"
                aria-controls="userDropdown">

            <div class="user-avatar">
                @(string.IsNullOrWhiteSpace(User.Identity.Name)
                            ? "U"
                            : User.Identity.Name[0]
                            .ToString()
                            .ToUpper())
        </div>

            <div class="user-summary">

                <span class="user-name">
                    @User.Identity.Name
                </span>

                <span class="user-role">
                    @User.FindFirstValue(ClaimTypes.Role)
                </span>

            </div>

            <span class="user-arrow">
                ▼
            </span>

        </button>


        <div class="user-dropdown"
             id="userDropdown">

            <div class="user-dropdown-header">

                <strong>
                    @User.Identity.Name
                </strong>

                <span>
                    @User.FindFirstValue(ClaimTypes.Role)
                </span>

            </div>

            <div class="user-dropdown-divider"></div>


            <a asp-controller="Profile"
               asp-action="Index"
               class="user-dropdown-item">
                Hồ sơ cá nhân
            </a>

            <a asp-controller="Profile"
               asp-action="Settings"
               class="user-dropdown-item">
                Cài đặt tài khoản
            </a>

            <a asp-controller="Profile"
               asp-action="ChangePassword"
               class="user-dropdown-item">
                Đổi mật khẩu
            </a>


            <div class="user-dropdown-divider"></div>


            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="user-dropdown-item logout-button">
                    Đăng xuất
                </button>

            </form>

        </div>
        }
    else
    {
        // ============================
        // CHƯA ĐĂNG NHẬP
        // ============================

        <button type="button"
                id="userMenuButton"
                class="user-button user-button-guest"
                aria-expanded="false"
                aria-controls="userDropdown"
                aria-label="Tài khoản">

            <svg viewBox="0 0 24 24"
                 class="user-icon"
                 aria-hidden="true">

                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />

            </svg>

        </button>


        <div class="user-dropdown guest-dropdown"
             id="userDropdown">

            <div class="guest-dropdown-title">
                Tài khoản
            </div>

            <a asp-controller="Auth"
               asp-action="Login"
               class="user-dropdown-item guest-login-button">
                Đăng nhập
            </a>

            <a asp-controller="Auth"
               asp-action="Register"
               class="user-dropdown-item guest-register-button">
                Đăng ký
            </a>

        </div>
    }

</div>