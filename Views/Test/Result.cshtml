@model TestResultViewModel
@{
    ViewData["Title"] = "Kết quả bài kiểm tra";
}
<section class="page">
    <header class="page-heading"><div><h1>Kết quả bài kiểm tra</h1><p>@Model.TestTitle · @(Model.Format == TestFormat.ToeicStyle ? "TOEIC-style" : "IELTS-style") · @Model.Mode · Điểm nội bộ SKDJK</p></div></header>
    <section class="card grid grid-2" style="align-items:center;margin-bottom:16px">
        <div style="display:grid;place-items:center"><div class="result-score">@Model.Score.ToString("0.##")%</div><span class="badge @(Model.IsPassed ? "success" : "danger")" style="margin-top:12px">@(Model.IsPassed ? "ĐẠT YÊU CẦU" : "CẦN CẢI THIỆN")</span></div>
        <div class="grid grid-2">
            <div><span class="muted">Số câu đúng</span><h2>@Model.CorrectCount</h2></div>
            <div><span class="muted">Số câu sai/chưa trả lời</span><h2>@Model.WrongCount</h2></div>
            <div><span class="muted">Tổng số câu</span><h2>@Model.TotalQuestions</h2></div>
            <div><span class="muted">Ngày nộp</span><h3>@Model.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</h3></div>
        </div>
    </section>

    @* Breakdown chỉ là phần trăm nội bộ theo Section, không quy đổi TOEIC/IELTS chính thức. *@
    <section class="card" style="margin-bottom:16px">
        <h2 style="margin-top:0">Kết quả theo phần</h2>
        <div class="grid grid-2">
            @foreach (var resultSection in Model.Sections)
            {
                <div><strong>@resultSection.SectionName</strong><p>@resultSection.CorrectCount/@resultSection.TotalQuestions câu · Điểm SKDJK: @resultSection.Score.ToString("0.##")%</p></div>
            }
        </div>
    </section>

    <section class="card">
        <h2 style="margin-top:0">Chi tiết câu trả lời</h2>
        <div class="grid">
            @foreach (var question in Model.Questions)
            {
                <article class="result-question @(question.IsCorrect ? "correct" : "")">
                    <strong>Câu @question.Number. @question.Content</strong>
                    <p>Bạn trả lời: <strong>@(string.IsNullOrWhiteSpace(question.UserAnswer) ? "Chưa trả lời" : question.UserAnswer)</strong></p>
                    @if (!question.IsCorrect)
                    {
                        <p class="muted">Đáp án đúng: @question.CorrectAnswer</p>
                    }
                </article>
            }
        </div>
    </section>
    <div class="vocab-actions"><a asp-action="Take" asp-route-id="@Model.TestId" class="button secondary">↻ Làm lại</a><a asp-action="History" class="button secondary">Lịch sử</a><a asp-action="Index" class="button">← Quay lại danh sách</a></div>
</section>
