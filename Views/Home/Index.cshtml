@{
    ViewData["Title"] = "Trang chủ";
}

<section class="welcome-section">
    <h1>Xin chào, Người học!</h1>
    <p>Hãy tiếp tục hành trình học ngoại ngữ của bạn.</p>
</section>

<section class="summary-grid">
    <div class="summary-card">
        <div class="summary-icon">📖</div>
        <strong>12</strong>
        <span>Số chủ đề đã học</span>
    </div>

    <div class="summary-card">
        <div class="summary-icon">☑</div>
        <strong>8</strong>
        <span>Số bài kiểm tra đã làm</span>
    </div>

    <div class="summary-card">
        <div class="progress-circle" data-progress-circle="65">
            <span>65%</span>
        </div>
        <span>Tiến độ học tập</span>
    </div>
</section>

<section class="content-card continue-card">
    <h2>Tiếp tục học</h2>

    <div class="continue-content">
        <div class="lesson-image">🖼</div>

        <div class="lesson-info">
            <h3>Chủ đề: Du lịch</h3>
            <p>Bài học: Đặt phòng khách sạn</p>

            <div class="progress-line">
                <div class="progress-value" data-progress="65"></div>
            </div>
        </div>

        <div class="continue-action">
            <strong>65%</strong>
            <button class="secondary-button" type="button">
                Tiếp tục học
            </button>
        </div>
    </div>
</section>

<section class="content-card">
    <h2>Gợi ý chủ đề dành cho bạn</h2>

    <div class="topic-grid home-topic-grid">
        <article class="topic-card">
            <div class="topic-image">🍜</div>
            <h3>Ẩm thực</h3>
            <p>Cấp độ: Trung cấp</p>
            <button class="outline-button" type="button">Xem chi tiết</button>
        </article>

        <article class="topic-card">
            <div class="topic-image">💼</div>
            <h3>Kinh doanh</h3>
            <p>Cấp độ: Cao cấp</p>
            <button class="outline-button" type="button">Xem chi tiết</button>
        </article>

        <article class="topic-card">
            <div class="topic-image">❤</div>
            <h3>Sức khỏe</h3>
            <p>Cấp độ: Cơ bản</p>
            <button class="outline-button" type="button">Xem chi tiết</button>
        </article>

        <article class="topic-card">
            <div class="topic-image">💻</div>
            <h3>Công nghệ</h3>
            <p>Cấp độ: Trung cấp</p>
            <button class="outline-button" type="button">Xem chi tiết</button>
        </article>
    </div>
</section>
