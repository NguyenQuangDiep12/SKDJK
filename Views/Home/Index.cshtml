@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var overallWidth = $"{Math.Clamp(Model.OverallProgress, 0, 100):0}%";
}
<section class="page">
    <header class="page-heading card">
        <div>
            <h1>Xin chào, @Model.FullName!</h1>
            <p>Hãy tiếp tục hành trình học ngoại ngữ của bạn.</p>
        </div>
        @if (!Model.IsAuthenticated)
        {
            <a asp-controller="Auth" asp-action="Login" class="button">Bắt đầu học</a>
        }
    </header>

    @if (Model.IsAuthenticated)
    {
        <div class="grid grid-3" style="margin-bottom:16px">
            <article class="card stat-card"><span>▦ Số chủ đề đã học</span><strong>@Model.LearnedTopicCount</strong></article>
            <article class="card stat-card"><span>✓ Số bài kiểm tra đã làm</span><strong>@Model.CompletedTestCount</strong></article>
            <article class="card stat-card"><span>⌁ Tiến độ học tập</span><strong>@Model.OverallProgress.ToString("0")%</strong><div class="progress-track"><span style="width:@overallWidth"></span></div></article>
        </div>

        <section class="card" style="margin-bottom:16px">
            <h2 style="margin-top:0">Tiếp tục học</h2>
            @if (Model.ContinueLesson is null)
            {
                <p class="muted">Bạn chưa có bài học đang dở. Hãy chọn một chủ đề để bắt đầu.</p>
                <a asp-controller="Topic" asp-action="Index" class="button" style="margin-top:12px">Xem chủ đề</a>
            }
            else
            {
                var continueWidth = $"{Math.Clamp(Model.ContinueLesson.CompletionPercent, 0, 100):0}%";
                <div class="page-heading" style="margin:0">
                    <div style="min-width:0;flex:1">
                        <strong>@Model.ContinueLesson.LessonTitle</strong>
                        <p class="muted">Chủ đề: @Model.ContinueLesson.TopicName</p>
                        <div class="progress-track" style="margin-top:10px"><span style="width:@continueWidth"></span></div>
                    </div>
                    <a asp-controller="Lesson" asp-action="Index" asp-route-id="@Model.ContinueLesson.LessonId" class="button">Tiếp tục @Model.ContinueLesson.CompletionPercent.ToString("0")%</a>
                </div>
            }
        </section>

        <section class="card">
            <div class="page-heading"><div><h2 style="margin:0">Gợi ý chủ đề dành cho bạn</h2><p>Ưu tiên các chủ đề bạn chưa học.</p></div></div>
            @if (Model.SuggestedTopics.Count == 0)
            {
                <p class="muted">Hiện chưa có chủ đề mới để gợi ý.</p>
            }
            else
            {
                <div class="grid grid-4">
                    @foreach (var topic in Model.SuggestedTopics)
                    {
                        <article class="topic-card">
                            <img class="topic-image" src="@(string.IsNullOrWhiteSpace(topic.ImageUrl) ? "/images/topic-travel.svg" : topic.ImageUrl)" alt="Minh họa @topic.Name" />
                            <h3>@topic.Name</h3>
                            <p>@topic.Description</p>
                            <span class="badge">@topic.Level</span>
                            <a asp-controller="Topic" asp-action="Details" asp-route-id="@topic.TopicId" class="button" style="margin-top:10px">Xem chi tiết</a>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>
