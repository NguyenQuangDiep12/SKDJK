@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 - Forbidden</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f8f9fa;
            color: #333;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        .forbidden-card {
            background-color: #ffffff;
            padding: 40px 30px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            max-width: 480px;
            width: 100%;
        }

        .error-code {
            font-size: 100px;
            font-weight: 800;
            line-height: 1;
            color: #ffa502;
            margin-bottom: 10px;
            letter-spacing: -2px;
        }

        .error-title {
            font-size: 24px;
            font-weight: 700;
            color: #2f3542;
            margin-bottom: 12px;
        }

        .error-desc {
            font-size: 15px;
            color: #747d8c;
            margin-bottom: 28px;
            line-height: 1.5;
        }

        .btn-home {
            display: inline-block;
            padding: 12px 28px;
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            background-color: #2e86de;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

            .btn-home:hover {
                background-color: #1e6bb8;
                transform: translateY(-2px);
            }

            .btn-home:active {
                transform: translateY(0);
            }
    </style>
</head>
<body>

    <div class="forbidden-card">
        <div class="error-code">403</div>
        <h1 class="error-title">FORBIDDEN</h1>
        <p class="error-desc">Bạn không có quyền truy cập vào tài nguyên này. Vui lòng liên hệ quản trị viên hoặc quay lại trang chủ.</p>
        <a href="/" class="btn-home">Quay về trang chủ</a>
    </div>

</body>
</html>