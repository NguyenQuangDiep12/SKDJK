@model TopicDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết chủ đề";
}
<section class="page">
    <article class="card grid grid-2" style="margin-bottom:16px;align-items:center">
        <img class="topic-image" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/topic-travel.svg" : Model.ImageUrl)" alt="Minh họa @Model.Name" />
        <div>
            <h1>@Model.Name</h1>
            <p class="muted">@Model.Description</p>
            <div class="grid grid-2" style="margin-top:16px"><span class="badge">Cấp độ: @Model.Level</span><span class="badge">Ngôn ngữ: @Model.LanguageName</span></div>
        </div>
    </article>

    <section class="card">
        <h2 style="margin-top:0">Danh sách bài học</h2>
        @if (Model.Lessons.Count == 0)
        {
            <p class="muted">Chủ đề chưa có bài học.</p>
        }
        else
        {
            <div class="grid">
                @foreach (var lesson in Model.Lessons)
                {
                    var lessonWidth = $"{Math.Clamp(lesson.CompletionPercent, 0, 100):0}%";
                    <article class="card" style="box-shadow:none">
                        <div class="page-heading" style="margin:0">
                            <div style="flex:1">
                                <strong>@lesson.Title</strong>
                                <p class="muted">@lesson.Description</p>
                                <div class="progress-track" style="margin-top:9px"><span style="width:@lessonWidth"></span></div>
                            </div>
                            <a asp-controller="Lesson" asp-action="Index" asp-route-id="@lesson.Id" class="button">@(lesson.CompletionPercent > 0 ? "Tiếp tục" : "Vào học")</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</section>
