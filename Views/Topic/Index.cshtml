@model TopicListViewModel
@{
    ViewData["Title"] = "Danh sách chủ đề";
}
<section class="page">
    <header class="page-toolbar">
        <h1>Danh sách chủ đề</h1>
        <form method="get" asp-action="Index" class="filters">
            <input name="search" value="@Model.Search" placeholder="Tìm kiếm chủ đề..." />
            <select name="languageId">
                <option value="">Tất cả ngôn ngữ</option>
                @foreach (var language in Model.Languages)
                {
                    <option value="@language.Id" selected="@(Model.LanguageId == language.Id)">@language.Name</option>
                }
            </select>
            <select name="level">
                <option value="">Tất cả cấp độ</option>
                @foreach (var level in Model.Levels)
                {
                    <option value="@level" selected="@(Model.Level == level)">@level</option>
                }
            </select>
            <button class="button" type="submit">Lọc</button>
        </form>
    </header>

    @if (Model.Topics.Count == 0)
    {
        <div class="card muted">Không tìm thấy chủ đề phù hợp.</div>
    }
    else
    {
        <div class="card grid grid-4">
            @foreach (var topic in Model.Topics)
            {
                <article class="topic-card">
                    <img class="topic-image" src="@(string.IsNullOrWhiteSpace(topic.ImageUrl) ? "/images/topic-travel.svg" : topic.ImageUrl)" alt="Minh họa @topic.Name" />
                    <h3>@topic.Name</h3>
                    <p>@topic.LanguageName · @topic.Level</p>
                    <a asp-action="Details" asp-route-id="@topic.Id" class="button">Xem chi tiết</a>
                </article>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Phân trang chủ đề">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-languageId="@Model.LanguageId" asp-route-level="@Model.Level" asp-route-page="@pageNumber" asp-route-pageSize="@Model.PageSize" class="@(pageNumber == Model.Page ? "active" : "")">@pageNumber</a>
            }
        </nav>
    }
</section>
