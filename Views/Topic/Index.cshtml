@{
    ViewData["Title"] = "Danh sách chủ đề";
}

<section class="user-page topic-page">
    <div class="page-toolbar">
        <h1>Danh sách chủ đề</h1>

        <div class="topic-filters">
            <div class="search-field">
                <span>⌕</span>
                <input type="text" placeholder="Tìm kiếm chủ đề..." />
            </div>

            <select>
                <option>Chọn ngôn ngữ</option>
                <option>Tiếng Anh</option>
                <option>Tiếng Nhật</option>
            </select>

            <select>
                <option>Chọn cấp độ</option>
                <option>Cơ bản</option>
                <option>Trung cấp</option>
                <option>Nâng cao</option>
            </select>
        </div>
    </div>

    <div class="topic-card-grid">
        @for (var i = 1; i <= 12; i++)
        {
            <article class="topic-ui-card">
                <div class="topic-ui-image">▧</div>

                <h3>Ẩm thực</h3>

                <p>
                    Cấp độ @(i % 3 == 0 ? "cơ bản" : "trung cấp")
                </p>

                <a asp-controller="User"
                   asp-action="TopicDetails"
                   class="ui-primary-button">
                    Xem chi tiết
                </a>
            </article>
        }
    </div>

    <nav class="ui-pagination" aria-label="Phân trang">
        <button type="button">‹ <span>Trước</span></button>

        <div class="ui-pagination-pages">
            <button type="button" class="active">1</button>
            <button type="button">2</button>
            <button type="button">3</button>
            <button type="button">4</button>
        </div>

        <button type="button"><span>Sau</span> ›</button>
    </nav>
</section>
